{
  "name": "pacemates",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pacemates/web dev",
    "dev:api": "pnpm --filter @pacemates/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @pacemates/api db:generate",
    "db:migrate": "pnpm --filter @pacemates/api db:migrate",
    "db:seed": "pnpm --filter @pacemates/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "pnpm": {
    "overrides": {
      "body-parser@>=2.0.0 <2.4.0": ">=2.4.0",
      "qs@>=6.7.0 <=6.16.0": ">=6.16.1",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "esbuild@<=0.24.2": ">=0.25.0",
      "minimatch@>=7.0.0 <11.0.1": ">=11.0.1"
    }
  }
}
