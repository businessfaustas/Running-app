# Leave unset to run in on-device preview mode (sample data, accounts saved in the browser).
# Set both to use a real Supabase project. The Vercel ↔ Supabase integration's
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY also work.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Error tracking (Sentry DSN is public by design). Unset → errors only go to the console.
# VITE_SENTRY_DSN=

# The site's public address, for link previews. On Vercel the production domain is used
# automatically; set this only to override it.
# VITE_SITE_URL=https://your-domain.lt

# Kill switch: when set, every visitor sees a maintenance notice with this text instead of the
# app. Set it on Vercel and redeploy to take the site offline; remove it and redeploy to return.
# VITE_MAINTENANCE_MESSAGE=Tvarkome kai ką svarbaus. Grįžk po valandėlės!
